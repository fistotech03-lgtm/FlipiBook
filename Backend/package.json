{
  "name": "flipibook-backend",
  "version": "1.0.0",
  "description": "Flipbook Backend Microservices & API Gateway",
  "scripts": {
    "dev": "concurrently -n \"GATEWAY,AUTH,FLIPBOOK,PAGE_ED,PDF_ED,CUSTOM_ED,THREED_ED,PAYMENT,USER,ADMIN\" -c \"cyan,magenta,blue,yellow,green,red,white,yellow,gray,cyanBright\" \"npm run dev:gateway\" \"npm run dev:auth\" \"npm run dev:myflipibook\" \"npm run dev:page-editor\" \"npm run dev:pdf-editor\" \"npm run dev:customized-editor\" \"npm run dev:threed-editor\" \"npm run dev:payment\" \"npm run dev:user\" \"npm run dev:admin\"",
    "start": "concurrently -n \"GATEWAY,AUTH,FLIPBOOK,PAGE_ED,PDF_ED,CUSTOM_ED,THREED_ED,PAYMENT,USER,ADMIN\" -c \"cyan,magenta,blue,yellow,green,red,white,yellow,gray,cyanBright\" \"npm run start:gateway\" \"npm run start:auth\" \"npm run start:myflipibook\" \"npm run start:page-editor\" \"npm run start:pdf-editor\" \"npm run start:customized-editor\" \"npm run start:threed-editor\" \"npm run start:payment\" \"npm run start:user\" \"npm run start:admin\"",
    "start:gateway": "node api-gateway/src/server.js",
    "start:auth": "node services/auth-service/src/server.js",
    "start:myflipibook": "node services/myflipibook-service/src/server.js",
    "start:page-editor": "node services/page-editor-service/src/server.js",
    "start:pdf-editor": "node services/pdf-editor-service/src/server.js",
    "start:customized-editor": "node services/customized-editor-service/src/server.js",
    "start:threed-editor": "node services/threed-editor-service/src/server.js",
    "start:payment": "node services/payment-services/src/server.js",
    "start:user": "node services/user-service/src/server.js",
    "start:admin": "node services/admin-service/src/server.js",
    "dev:gateway": "node --watch-path=api-gateway/src api-gateway/src/server.js",
    "dev:auth": "node --watch-path=services/auth-service/src services/auth-service/src/server.js",
    "dev:myflipibook": "node --watch-path=services/myflipibook-service/src services/myflipibook-service/src/server.js",
    "dev:page-editor": "node --watch-path=services/page-editor-service/src services/page-editor-service/src/server.js",
    "dev:pdf-editor": "node --watch-path=services/pdf-editor-service/src services/pdf-editor-service/src/server.js",
    "dev:customized-editor": "node --watch-path=services/customized-editor-service/src services/customized-editor-service/src/server.js",
    "dev:threed-editor": "node --watch-path=services/threed-editor-service/src services/threed-editor-service/src/server.js",
    "dev:payment": "node --watch-path=services/payment-services/src services/payment-services/src/server.js",
    "dev:user": "node --watch-path=services/user-service/src services/user-service/src/server.js",
    "dev:admin": "node --watch-path=services/admin-service/src services/admin-service/src/server.js",
    "install:services": "for dir in api-gateway services/*; do if [ -f \"$dir/package.json\" ]; then (cd \"$dir\" && npm install); fi; done",
    "install:all": "npm install && npm run install:services"
  },
  "dependencies": {
    "concurrently": "^10.0.5",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.7",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "append-field": "^1.0.0",
    "busboy": "^1.6.0",
    "streamsearch": "^1.1.0",
    "multer": "^2.4.0",
    "nanoid": "^6.0.2",
    "nodemailer": "^10.0.12",
    "pdf-lib": "^1.17.1",
    "adm-zip": "^0.6.1"
  }
}
