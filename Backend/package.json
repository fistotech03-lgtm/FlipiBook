{
  "name": "flipibook-backend",
  "version": "1.0.0",
  "description": "Flipbook Backend Microservices & API Gateway",
  "scripts": {
    "dev": "concurrently -n \"GATEWAY,AUTH,FLIPBOOK,PAGE_ED,PDF_ED\" -c \"cyan,magenta,blue,yellow,green\" \"npm run dev:gateway\" \"npm run dev:auth\" \"npm run dev:myflipibook\" \"npm run dev:page-editor\" \"npm run dev:pdf-editor\"",
    "start": "concurrently -n \"GATEWAY,AUTH,FLIPBOOK,PAGE_ED,PDF_ED\" -c \"cyan,magenta,blue,yellow,green\" \"npm run start:gateway\" \"npm run start:auth\" \"npm run start:myflipibook\" \"npm run start:page-editor\" \"npm run start:pdf-editor\"",
    "start:gateway": "node api-gateway/src/server.js",
    "start:auth": "node services/auth-service/src/server.js",
    "start:myflipibook": "node services/myflipibook-service/src/server.js",
    "start:page-editor": "node services/page-editor-service/src/server.js",
    "start:pdf-editor": "node services/pdf-editor-service/src/server.js",
    "dev:gateway": "node --watch api-gateway/src/server.js",
    "dev:auth": "node --watch services/auth-service/src/server.js",
    "dev:myflipibook": "node --watch services/myflipibook-service/src/server.js",
    "dev:page-editor": "node --watch services/page-editor-service/src/server.js",
    "dev:pdf-editor": "node --watch services/pdf-editor-service/src/server.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.7",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "multer": "^2.4.0",
    "nanoid": "^6.0.2",
    "nodemailer": "^10.0.12",
    "pdf-lib": "^1.17.1",
    "adm-zip": "^0.6.1"
  }
}
