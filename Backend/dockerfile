FROM node:22-alpine

# Install Inkscape, LibreOffice (headless), and fonts for PDF/document rendering
RUN apk add --no-cache \
    inkscape \
    libreoffice \
    ttf-dejavu \
    font-noto

WORKDIR /app

COPY package*.json ./

RUN npm install

COPY . .

EXPOSE 8000 5001 5002 5003 5004

CMD ["npm", "run", "dev"]