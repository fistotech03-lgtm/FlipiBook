# ==============================================================================
# Stage 1: Build Frontend React Bundle with Vite
# ==============================================================================
FROM node:22-bookworm-slim AS frontend-builder

WORKDIR /app/frontend

# Copy package.json only to prevent cross-platform lockfile conflicts
# (Fixes npm issue #4828 where Windows/macOS package-lock.json strips Linux native bindings like @rolldown/binding-linux-x64-*)
COPY Frontend/package.json ./
RUN npm install

COPY Frontend/ ./

ARG VITE_GOOGLE_CLIENT_ID=""
ENV VITE_BACKEND_URL=""
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID

RUN npm run build

# ==============================================================================
# Stage 2: Full-Stack Preview Runner (Nginx + Backend Microservices)
# ==============================================================================
FROM node:22-alpine

# Install Nginx for ultra-fast static asset delivery and reverse proxying
RUN apk add --no-cache nginx

WORKDIR /app

# Install Backend dependencies
COPY Backend/package*.json ./Backend/
RUN cd /app/Backend && npm install

# Copy Backend source code
COPY Backend/ ./Backend/

# Copy built Frontend static assets
COPY --from=frontend-builder /app/frontend/dist /usr/share/nginx/html

# Configure Nginx for preview routing
COPY Frontend/nginx.preview.conf /etc/nginx/conf.d/default.conf

# Prepare storage directory and Nginx run directory
RUN mkdir -p /app/storage /run/nginx

# Copy and setup entrypoint script
COPY preview-entrypoint.sh /app/preview-entrypoint.sh
RUN chmod +x /app/preview-entrypoint.sh

# Expose HTTP port for Dokploy Traefik routing
EXPOSE 80

# Environment defaults for preview
ENV NODE_ENV=production
ENV GATEWAY_PORT=8000
ENV AUTH_PORT=5001
ENV AUTH_SERVICE_PORT=5001
ENV AUTH_SERVICE_URL=http://127.0.0.1:5001
ENV MYFLIPIBOOK_PORT=5002
ENV MYFLIPIBOOK_SERVICE_URL=http://127.0.0.1:5002
ENV PAGE_EDITOR_PORT=5003
ENV PAGE_EDITOR_SERVICE_URL=http://127.0.0.1:5003
ENV PDF_EDITOR_PORT=5004
ENV PDF_EDITOR_SERVICE_URL=http://127.0.0.1:5004
ENV CUSTOMIZED_EDITOR_PORT=5005
ENV CUSTOMIZED_EDITOR_SERVICE_URL=http://127.0.0.1:5005
ENV THREED_EDITOR_PORT=5006
ENV THREED_EDITOR_SERVICE_URL=http://127.0.0.1:5006
ENV PAYMENT_PORT=5007
ENV PAYMENT_SERVICE_PORT=5007
ENV PAYMENT_SERVICE_URL=http://127.0.0.1:5007
ENV STORAGE_PATH=/app/storage

CMD ["/app/preview-entrypoint.sh"]
